# RAGamer 配置模板。
# 复制成 .env 后按注释填值：cp .env.example .env
# 只有 RAGAMER_ 前缀的键会被读取（同机上的其它项目可以共用一份 shell 环境不串味）；
# 前后缀内的键名拼错会在启动时报错，不会静默忽略。
# 这里的值都是占位符，不含任何真实凭据。

# ── 日志 ──
# 日志等级：DEBUG / INFO / WARNING / ERROR / CRITICAL
RAGAMER_LOG_LEVEL=INFO

# ── 存储（Milvus / Mongo / MinIO 共用）──
# 连接与启动自检的超时（秒）。远端不可达时在这一点时间内失败，
# 错误信息里点名是哪个服务、哪个地址
RAGAMER_STORE_TIMEOUT_SECONDS=5

# ── Milvus（向量库）──
# 每款游戏一个 collection；database 用于与原项目隔离，不要沿用原项目的库名
# 服务地址，形如 http://<host>:19530
RAGAMER_MILVUS_URI=http://your-milvus-host:19530
# 鉴权 token。云端 Milvus 必须开启鉴权，不接受匿名访问
RAGAMER_MILVUS_TOKEN=your-milvus-token
# database 名。不能叫 default：那是 Milvus 自带的库，与原项目共用实例时会撞在一起
RAGAMER_MILVUS_DB=ragamer

# ── MongoDB（会话、知识库元数据、术语映射）──
# 连接串，形如 mongodb://<user>:<password>@<host>:27017/?authSource=admin
RAGAMER_MONGO_URI=mongodb://your-mongo-host:27017
# 库名，与原项目错开
RAGAMER_MONGO_DB=ragamer

# ── MinIO（原图等对象存储）──
# 服务地址，形如 <host>:9000
RAGAMER_MINIO_ENDPOINT=your-minio-host:9000
RAGAMER_MINIO_ACCESS_KEY=your-minio-access-key
RAGAMER_MINIO_SECRET_KEY=your-minio-secret-key
# 桶名，与原项目错开。启动时确保存在（不存在就创建）
# 部署侧还有一件事不在这里：MinIO 容器的卷要预建并修好属主，
# 它以固定的非 root uid 运行，属主不对直接起不来——应用这侧只会看到"连不上"
RAGAMER_MINIO_BUCKET=ragamer-images
# 是否走 TLS（true 时用 https）
RAGAMER_MINIO_SECURE=false

# ── 语言模型（打标兜底、查询路由、多查询改写、生成）──
# OpenAI 兼容接口的地址
RAGAMER_LLM_BASE_URL=https://your-llm-endpoint/v1
RAGAMER_LLM_API_KEY=your-llm-api-key
# 模型名
RAGAMER_LLM_MODEL=deepseek-chat
