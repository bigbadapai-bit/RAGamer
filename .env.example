# RAGamer 配置模板。复制成 .env 再按注释填：cp .env.example .env
#
# 只有 RAGAMER_ 前缀的键会被读取；键名拼错、或写了个不存在的键，启动时报错，不会静默忽略。
# 取值里不要出现 ${...}：.env 会先把它展开，实际生效的与你写的不一致（同样会被拦下）。
# 文件必须存成 UTF-8（带 BOM 也认）。
# 本文件里的值都是占位符，不含任何真实凭据。

# ── 日志 ──
# DEBUG / INFO / WARNING / ERROR / CRITICAL
RAGAMER_LOG_LEVEL=INFO

# ── 存储（Milvus / Mongo / MinIO 共用）──
# 连接与启动自检的超时（秒）。超时后报错会点名是哪个服务、哪个地址
RAGAMER_STORE_TIMEOUT_SECONDS=5

# ── Milvus（向量库）──
# 服务地址，形如 http://<host>:19530
RAGAMER_MILVUS_URI=http://your-milvus-host:19530
# 鉴权 token，格式是「用户名:密码」拼成一整串（不是只填密码）。云端 Milvus 必须开鉴权，
# 不接受匿名访问
RAGAMER_MILVUS_TOKEN=root:your-milvus-password
# database 名。每款游戏在它下面各占一个 collection。不能填 default——那是 Milvus 自带的库，
# 与原项目共用实例时会撞在一起
RAGAMER_MILVUS_DB=ragamer

# ── MongoDB（会话、知识库元数据、术语映射）──
# 连接串。账号要对 RAGAMER_MONGO_DB 那个库有 readWrite，否则自检报 not authorized；
# authSource 填账号被创建时所在的那个库
RAGAMER_MONGO_URI=mongodb://<user>:<password>@your-mongo-host:27017/?authSource=ragamer
# 库名，与原项目错开
RAGAMER_MONGO_DB=ragamer

# ── MinIO（原图等对象存储）──
# 服务地址，形如 <host>:9000
RAGAMER_MINIO_ENDPOINT=your-minio-host:9000
RAGAMER_MINIO_ACCESS_KEY=your-minio-access-key
RAGAMER_MINIO_SECRET_KEY=your-minio-secret-key
# 桶名，启动时不存在就创建。与原项目错开
RAGAMER_MINIO_BUCKET=ragamer-images
# true 走 https
RAGAMER_MINIO_SECURE=false

# ── Redis（答案缓存与提问计数）──
# 连接串，形如 redis://[:密码@]主机:6379/0。**连不上不影响作答**，只是这次不缓存、
# 热门问题为空——所以它不在启动自检里
RAGAMER_REDIS_URL=redis://your-redis-host:6379/0
# 键前缀。与原项目共用一套实例时靠它错开——按前缀失效是真的在删键，撞上就是删别人的数据
RAGAMER_REDIS_PREFIX=ragamer

# ── 语言模型（打标兜底、查询路由、多查询改写、生成）──
# OpenAI 兼容接口的地址
RAGAMER_LLM_BASE_URL=https://your-llm-endpoint/v1
RAGAMER_LLM_API_KEY=your-llm-api-key
RAGAMER_LLM_MODEL=deepseek-chat
# 单次请求超时（秒）。流式按两次产出之间的间隔算，不是整段答案的耗时
RAGAMER_LLM_TIMEOUT=60
# 一次调用的总尝试次数（含首次）。超时与限流会重试，被截断不会
RAGAMER_LLM_MAX_ATTEMPTS=3
# 重试退避的起始与封顶（秒），中间按 2 的幂增长
RAGAMER_LLM_BACKOFF_BASE=0.5
RAGAMER_LLM_BACKOFF_MAX=8

# ── 视觉模型（给每张图补一段摘要，写进替代文本）──
# 读图的模型与写字的模型通常不是同一个，所以单独配一组。
# **下面三个键要么都给、要么都不给**：整组不配时补图只做二次 OCR，图里没文字的那几张
# （立绘、示意图）会少掉可检索的文本，其余一切照旧；只给一半会在启动时报错。
# 三个都留空 = 不启用
RAGAMER_VISION_BASE_URL=
RAGAMER_VISION_API_KEY=
# 模型名，形如 qwen-vl-max
RAGAMER_VISION_MODEL=
# 单次请求超时（秒）
RAGAMER_VISION_TIMEOUT=60
# 一次调用的总尝试次数（含首次）
RAGAMER_VISION_MAX_ATTEMPTS=3
RAGAMER_VISION_BACKOFF_BASE=0.5
RAGAMER_VISION_BACKOFF_MAX=8

# ── MinerU（PDF 与图片 → Markdown 的云端解析）──
# 流程：申请上传链接 → PUT 上传 → 轮询结果 → 下载结果包。版面分析在云端做，本地不装 magic-pdf。
# 图片区域里的文字 MinerU 一个字都不给，导入 PDF 与图片要装可选的 ocr 组做本地二次 OCR：
# uv sync --extra ocr
# 服务根地址。结尾带不带 /api/v4 都认
RAGAMER_MINERU_BASE_URL=https://mineru.net
# 官网申请的 Token
RAGAMER_MINERU_API_KEY=your-mineru-api-key
# 解析后端：pipeline / vlm / MinerU-HTML。默认 vlm——只有它会分析图内文字
RAGAMER_MINERU_MODEL_VERSION=vlm
# 轮询间隔（秒）。再密也只是空转
RAGAMER_MINERU_POLL_INTERVAL_SECONDS=3
# 轮询总时长上限（秒）。到点还没解析完就报错，不无限等
RAGAMER_MINERU_POLL_TIMEOUT_SECONDS=600
# 单次 HTTP 请求超时（秒）。上传与下载都是几十上百 MB，不能用几秒的默认值
RAGAMER_MINERU_REQUEST_TIMEOUT_SECONDS=300

# ── 向量化与精排（本地模型，共用一组加载参数）──
# 两个模型都在本机跑，所以设备与精度只有一份配置。
# 权重是第一次真要向量化时才加载的，启动自检不会等它。
# 跑真实模型要先装可选的 models 组（会拉进 torch，几个 G）：uv sync --extra models

# 加载到哪个设备：cpu / cuda / cuda:0
RAGAMER_MODELS_DEVICE=cpu
# 半精度。GPU 上开能省一半显存；CPU 上开着也无所谓，库会转回单精度
RAGAMER_MODELS_FP16=false

# 向量化模型。可以填 HuggingFace 模型名，也可以填本地权重目录（如 D:/models/bge-m3，用正斜杠）。
# 填本地目录时，目录里除了权重和 config.json，还要有 bge-m3 的 sparse_linear.pt 与
# colbert_linear.pt——稀疏那一路靠它，缺了只会记一条 INFO 然后拿随机权重接着跑
RAGAMER_EMBED_MODEL=BAAI/bge-m3
# 一次喂给模型几条文本
RAGAMER_EMBED_BATCH_SIZE=8
# 单条文本的 token 上限。**不要往下调**——超出的部分会被静默截断，内容永久缺失且不报错。
# 真正生效的上限由模型自己的上下文长度决定，这里只是防手滑
RAGAMER_EMBED_MAX_LENGTH=8192

# 精排模型。同样可以填模型名或本地权重目录。**要用长上下文那一版**（v2-m3，8192 token）：
# 换回 512 token 的老模型，超长候选会被截断，而截断是静默的
RAGAMER_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 一次算几条候选的分数
RAGAMER_RERANK_BATCH_SIZE=8
# 单条候选的 token 上限。同样**不要往下调**，理由同上——精排不该截断候选
RAGAMER_RERANK_MAX_LENGTH=8192

# ── 网页抓取（导入网址时用）──
# 一律遵守站点的 robots.txt，没有关掉它的开关。
# 请求头里的身份。**不要改成匿名的通用值**：站点按 UA 匹配 robots 规则，不肯说自己是谁的
# 爬虫被拦下来是应该的。带上联系地址，站长才找得到人
RAGAMER_CRAWL_USER_AGENT=RAGamerBot/0.1 (+https://github.com/bigbadapai-bit/RAGamer)
# 单次请求超时（秒）
RAGAMER_CRAWL_TIMEOUT=15
# 同一台主机两次请求之间的最小间隔（秒）。限的是主机不是页面。0 表示不限，只在自己搭的站上这么配
RAGAMER_CRAWL_MIN_INTERVAL=1
# 单个页面的字节上限。超了当场报错而不是截断——截断的网页会安静地少掉后半篇，
# 而导入看着是成功的
RAGAMER_CRAWL_MAX_BYTES=5000000

# ── 联网兜底路的外部检索（整组可以不配）──
# 只有「时效型」问题会走到它：本地语料是导进来那一刻的快照，网游的版本更新、活动公告
# 天然滞后，这一路补的就是这个。接的是博查（Bocha）Web Search，密钥申请：https://open.bochaai.com/
# 不配也能跑——没配密钥时这一路跳过并留一条痕，其余几路照常作答。配错了（密钥无效、
# 余额不足）按 ERROR 报出来：那之后每一次都会失败，只留 WARNING 会让人以为是偶发。
# 验活（真发请求、按次计费，约 ¥0.04/次）：uv run pytest -m integration -k websearch

# 检索服务地址。换别家就是改这一行加一个适配器，调用方不动
RAGAMER_SEARCH_BASE_URL=https://api.bocha.cn/v1/web-search
# 密钥。留空即没配，这一路跳过
RAGAMER_SEARCH_API_KEY=
# 单次请求超时（秒）。比语言模型那一侧短，等不到就该让其余几路先出答案
RAGAMER_SEARCH_TIMEOUT=10

# 这一组**只有这三个键，是有意的**：一次取几条、时间范围（博查的 freshness）、长摘要开关
# 这些是检索质量的调参，按本仓约定留在代码里（架构文档 §11「任何调参都应先有评测集」——
# 做成环境变量等于请人在没有评测集时去拧它）。限定域名（博查的 include）属于每个游戏一份的
# 数据，真要用也该进知识库元数据，不是进程级配置。
